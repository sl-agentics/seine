package rule_table;
//generated from Decision Table
// rule values at A11, header at A6
rule "rule_6_1"
	agenda-group "grid"
	when
		$p : Person()
		Age(band == "young")
		Tier(name == "gold")
	then
		insert(new Discount(10));
end

rule "rule_6_2"
	agenda-group "grid"
	when
		$p : Person()
		Age(band == "young")
		Tier(name == "silver")
	then
		insert(new Discount(5));
end

