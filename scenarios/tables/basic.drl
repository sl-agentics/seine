package pricing_rules;
//generated from Decision Table
import org.acme.Person;
// rule values at A9, header at A4
rule "Discounts_9"
	when
		Person(age > 30)
		Person(tier == "gold")
	then
		insert(new Discount(10));
end

// rule values at A10, header at A4
rule "Discounts_10"
	when
		Person(tier == "silver")
	then
		insert(new Discount(5));
end

// rule values at A11, header at A4
rule "Discounts_11"
	when
		Person(age > 65)
	then
		insert(new Discount(15));
end

